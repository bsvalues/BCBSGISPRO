# TerraFusion GIS Workflow Assistant - Local Configuration
# Benton County, Washington Edition

# Local LLM Configuration
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=mistral:7b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Alternative LLM endpoints (uncomment as needed)
# LLM_ENDPOINT=http://localhost:1234/v1  # LM Studio
# LLM_ENDPOINT=http://localhost:8080     # Ollama alternative port

# RAG System Configuration
RAG_ENABLED=true
RAG_DB_PATH=./rag/chroma_db
RAG_COLLECTION=benton_county_gis
RAG_SEARCH_RESULTS=3

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database Paths (Local File System)
DOCUMENTS_PATH=./rag/documents
LOGS_PATH=./logs
PROMPTS_PATH=./prompts

# Benton County Specific Configuration
COUNTY_NAME=Benton County
COUNTY_STATE=Washington
COUNTY_FIPS=53005
ASSESSOR_OFFICE=Benton County Assessor

# Assessment Configuration
ASSESSMENT_DATE=2024-01-01
REVALUATION_CYCLE=6
CURRENT_TAX_YEAR=2024

# Validation Settings
STRICT_VALIDATION=true
COMPLIANCE_LEVEL=high
AUDIT_LOGGING=true

# Agent Mesh Configuration
WORKFLOW_AGENT_ENABLED=true
JUDGE_AGENT_ENABLED=true
NARRATOR_AGENT_ENABLED=true

# Prompt Approval Queue
PROMPT_APPROVAL_REQUIRED=false
PROMPT_QUEUE_PATH=./logs/pending-prompts.json

# Local File Paths (No Internet Required)
LOCAL_MODELS_PATH=../models
PORTABLE_NODE_PATH=../node
PORTABLE_PYTHON_PATH=../python

# Performance Settings
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30000
CACHE_DURATION=3600

# Security Settings (Local System)
CORS_ORIGIN=http://localhost:3001
API_RATE_LIMIT=100
SESSION_SECRET=benton_county_gis_local_session

# Offline Mode
OFFLINE_MODE=true
INTERNET_REQUIRED=false
EXTERNAL_API_CALLS=false