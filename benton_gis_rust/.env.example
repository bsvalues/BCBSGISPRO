# TerraFusion Platform Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=sqlite:./data/benton_gis.db
DATA_DIR=./data

# ArcGIS Configuration (for Benton County data)
ARCGIS_API_KEY=your_arcgis_api_key_here

# Mapbox Configuration (for map display)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Server Configuration
RUST_LOG=info
BIND_ADDRESS=0.0.0.0:8080

# Optional: External Service Configuration
# SMTP_SERVER=smtp.example.com
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password